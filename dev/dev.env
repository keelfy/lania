# Environment of the local test stack. Sourced by dev/dev.sh, so it wins over any apps/*/.env file.

# MariaDB
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_NAME=lania

# API
PORT=8080
CONTEXT_TIMEOUT_MS=5000
DEBUG=true
API_KEY=local-api-key
JWT_SECRET=local-jwt-secret
ORY_URL=http://localhost:4433
REDIS_URL=redis://127.0.0.1:6379
# nothing listens here: shell calls fail fast and pages fall back to offline
SHELL_ADDRESS=127.0.0.1:9090
SHELL_TOKEN=
CORS_ALLOWED_ORIGINS=http://localhost:3000
ACTIVE_SEASON_ID=123e4567-e89b-12d3-a456-426614174003
MAX_PROFILES_PER_USER=2
DEFAULT_NAME_COLOR_ID=2628bf9d-5b7c-438b-900a-67753261a823
ED_SKIP_SIGNATURE_VERIFICATION=true

# Front
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080
NEXT_PUBLIC_ORY_SDK_URL=http://localhost:4433
NEXT_PUBLIC_DOMAIN=http://localhost:3000
NEXT_PUBLIC_ACTIVE_SEASON_ID=123e4567-e89b-12d3-a456-426614174003
NEXT_PUBLIC_IMGPROXY_ENDPOINT=http://localhost:8100

# Test account created by `dev.sh seed`
DEV_USER_EMAIL=test@lania.local
DEV_USER_PASSWORD=lania-local-pass
