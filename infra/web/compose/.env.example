# This is a reference template only. The real `.env` used on the server is
# rendered by Terraform from environments/prod/terraform.tfvars and uploaded
# alongside this compose stack — see infra/web/terraform/environments/prod.
# Do not put real secrets in this file.

IMAGE_TAG=latest
ACME_EMAIL=you@example.com

# --- API ---
PORT=8080
CONTEXT_TIMEOUT_MS=5000
DEBUG=false
TZ=Etc/UTC

API_KEY=CHANGEME

ORY_URL=http://kratos:4433
ORY_ADMIN_URL=http://kratos:4434
JWT_SECRET=CHANGEME

DATABASE_HOST=mariadb
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=CHANGEME
DATABASE_NAME=lania

SHELL_ADDRESS=shell:9090
SHELL_TOKEN=CHANGEME

# --- Shell (Minecraft plugin tables, same database as the API) ---
LUCKPERMS_USER_PERMISSIONS_TABLE_NAME=luckperms_user_permissions
PLAN_USERS_TABLE_NAME=plan_users
PLAN_SESSIONS_TABLE_NAME=plan_sessions
FLECTONE_PLAYER_TABLE_NAME=player
RCON_ADDRESS=
RCON_PASSWORD=

REDIS_URL=redis://redis:6379

CORS_ALLOWED_ORIGINS=https://www.lania.network

MAX_PROFILES_PER_USER=2
DEFAULT_NAME_COLOR_ID=2628bf9d-5b7c-438b-900a-67753261a823

FREEKASSA_BASE_PAYMENT_URL=
FREEKASSA_MERCHANT_ID=
FREEKASSA_MERCHANT_PASSWORD_1=
FREEKASSA_MERCHANT_PASSWORD_2=

DONATION_ALERTS_CLIENT_ID=
DONATION_ALERTS_CLIENT_SECRET=
DONATION_ALERTS_SCOPE=oauth-user-show oauth-donation-index oauth-donation-subscribe
DONATION_ALERTS_SOCKET_CONNECTION_TOKEN=
DONATION_ALERTS_USER_ID=

TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# --- S3 (admin image uploads) ---
S3_BUCKET=lania-web-134312503254-eu-central-1-an
S3_REGION=eu-central-1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
AWS_ACCESS_KEY_ID=CHANGEME
AWS_SECRET_ACCESS_KEY=CHANGEME

# --- Frontend ---
# NOTE: the NEXT_PUBLIC_* vars below are NOT read at container runtime - Next.js
# inlines them into the client bundle at build time. They must be passed as
# --build-arg when building the frontend image (see .github/workflows/deploy.yml).
# They're listed here only as the source of truth for what those build-args should be.
NEXT_PUBLIC_DOMAIN=https://www.lania.network
NEXT_PUBLIC_BACKEND_URL=https://api.lania.network
NEXT_PUBLIC_ORY_SDK_URL=https://accounts.lania.network
NEXT_PUBLIC_SUPPORT_EMAIL=contact@lania.network
NEXT_PUBLIC_SUPPORT_URL=/support
NEXT_PUBLIC_TELEGRAM_CHANNEL_URL=https://t.me/laniamc
NEXT_PUBLIC_DISCORD_SERVER_URL=https://discord.gg/laniamc

# --- MariaDB (container init) ---
MARIADB_ROOT_PASSWORD=CHANGEME

# --- Postgres (Kratos storage) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGEME
POSTGRES_DB=kratos

# --- Grafana ---
GRAFANA_ADMIN_PASSWORD=CHANGEME

# --- Kratos ---
SECRETS_COOKIE=CHANGEME
SECRETS_CIPHER=CHANGEME-32-BYTES-LONG-SECRET!!
COURIER_SMTP_CONNECTION_URI=smtps://user:pass@smtp.example.com:465/

SELFSERVICE_METHODS_OIDC_CONFIG_PROVIDERS_0_CLIENT_ID=
SELFSERVICE_METHODS_OIDC_CONFIG_PROVIDERS_0_CLIENT_SECRET=
SELFSERVICE_METHODS_OIDC_CONFIG_PROVIDERS_1_CLIENT_ID=
SELFSERVICE_METHODS_OIDC_CONFIG_PROVIDERS_1_CLIENT_SECRET=
SELFSERVICE_METHODS_OIDC_CONFIG_PROVIDERS_2_CLIENT_ID=
SELFSERVICE_METHODS_OIDC_CONFIG_PROVIDERS_2_CLIENT_SECRET=
SELFSERVICE_METHODS_OIDC_CONFIG_PROVIDERS_3_CLIENT_ID=
SELFSERVICE_METHODS_OIDC_CONFIG_PROVIDERS_3_CLIENT_SECRET=
