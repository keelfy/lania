IMAGE_TAG=${image_tag}

# --- API ---
PORT=8080
CONTEXT_TIMEOUT_MS=5000
DEBUG=false
TZ=Etc/UTC

API_KEY=${api_key}

ORY_URL=http://kratos:4433
ORY_ADMIN_URL=http://kratos:4434
JWT_SECRET=${jwt_secret}

DATABASE_HOST=${database_host}
DATABASE_PORT=${database_port}
DATABASE_USER=${database_user}
DATABASE_PASSWORD=${database_password}
DATABASE_NAME=${database_name}

SHELL_ADDRESS=shell:9090
SHELL_TOKEN=${shell_token}

# --- Shell (Minecraft plugin databases, same MariaDB instance) ---
DATABASE_PLAN_NAME=${database_plan_name}
DATABASE_FLECTONE_NAME=${database_flectone_name}
DATABASE_LUCKPERMS_NAME=${database_luckperms_name}
DATABASE_WHITELIST_NAME=${database_whitelist_name}
RCON_ADDRESS=${rcon_address}
RCON_PASSWORD=${rcon_password}

REDIS_URL=redis://redis:6379

CORS_ALLOWED_ORIGINS=https://www.${domain}

PRIMARY_SEASON_ID=${primary_season_id}
MAX_PROFILES_PER_USER=${max_profiles_per_user}
DEFAULT_NAME_COLOR_ID=${default_name_color_id}

FREEKASSA_BASE_PAYMENT_URL=${freekassa_base_payment_url}
FREEKASSA_MERCHANT_ID=${freekassa_merchant_id}
FREEKASSA_MERCHANT_PASSWORD_1=${freekassa_merchant_password_1}
FREEKASSA_MERCHANT_PASSWORD_2=${freekassa_merchant_password_2}

DONATION_ALERTS_CLIENT_ID=${donation_alerts_client_id}
DONATION_ALERTS_CLIENT_SECRET=${donation_alerts_client_secret}
DONATION_ALERTS_SCOPE=oauth-user-show oauth-donation-index oauth-donation-subscribe
DONATION_ALERTS_SOCKET_CONNECTION_TOKEN=${donation_alerts_socket_connection_token}
DONATION_ALERTS_USER_ID=${donation_alerts_user_id}

TWITCH_CLIENT_ID=${twitch_client_id}
TWITCH_CLIENT_SECRET=${twitch_client_secret}

# --- Frontend (reference only - baked in at image build time via --build-arg) ---
NEXT_PUBLIC_DOMAIN=https://www.${domain}
NEXT_PUBLIC_BACKEND_URL=https://api.${domain}
NEXT_PUBLIC_ORY_SDK_URL=https://accounts.${domain}
NEXT_PUBLIC_SUPPORT_EMAIL=${support_email}
NEXT_PUBLIC_SUPPORT_URL=/support
NEXT_PUBLIC_TELEGRAM_CHANNEL_URL=${telegram_channel_url}
NEXT_PUBLIC_DISCORD_SERVER_URL=${discord_server_url}

# --- MariaDB ---
MARIADB_ROOT_PASSWORD=${mariadb_root_password}

# --- Postgres (Kratos storage) ---
POSTGRES_USER=${postgres_user}
POSTGRES_PASSWORD=${postgres_password}
POSTGRES_DB=${postgres_db}

# --- Kratos ---
SECRETS_COOKIE=${kratos_secrets_cookie}
SECRETS_CIPHER=${kratos_secrets_cipher}
COURIER_SMTP_CONNECTION_URI=${courier_smtp_connection_uri}

SELFSERVICE_METHODS_OIDC_CONFIG_PROVIDERS_0_CLIENT_ID=${oidc_google_client_id}
SELFSERVICE_METHODS_OIDC_CONFIG_PROVIDERS_0_CLIENT_SECRET=${oidc_google_client_secret}
SELFSERVICE_METHODS_OIDC_CONFIG_PROVIDERS_1_CLIENT_ID=${oidc_discord_client_id}
SELFSERVICE_METHODS_OIDC_CONFIG_PROVIDERS_1_CLIENT_SECRET=${oidc_discord_client_secret}
SELFSERVICE_METHODS_OIDC_CONFIG_PROVIDERS_2_CLIENT_ID=${oidc_yandex_client_id}
SELFSERVICE_METHODS_OIDC_CONFIG_PROVIDERS_2_CLIENT_SECRET=${oidc_yandex_client_secret}
SELFSERVICE_METHODS_OIDC_CONFIG_PROVIDERS_3_CLIENT_ID=${oidc_twitch_client_id}
SELFSERVICE_METHODS_OIDC_CONFIG_PROVIDERS_3_CLIENT_SECRET=${oidc_twitch_client_secret}
