# Backend

LANIA_HOSTNAME=lania.gg 
LANIA_API_HOSTNAME=api.${LANIA_HOSTNAME}
LANIA_UI_HOSTNAME=${LANIA_HOSTNAME}

LANIA_API_KEY=123

# MariaDB Configuration

MARIADB_USER=root
MARIADB_PASSWORD=1q2w3e4r
MARIADB_DB=defaultdb

# Postgres Configuration

POSTGRES_USER=postgres
POSTGRES_PASSWORD=1q2w3e4r
POSTGRES_DB=kratos

# URLs
SERVE_PUBLIC_BASE_URL=https://ory.${LANIA_HOSTNAME}
SERVE_PUBLIC_CORS_ALLOWED_ORIGINS_0=https://${LANIA_API_HOSTNAME}
SERVE_PUBLIC_CORS_ALLOWED_ORIGINS_1=https://${LANIA_UI_HOSTNAME}

SERVE_ADMIN_BASE_URL=https://admin.ory.${LANIA_HOSTNAME}

SESSION_COOKIE_DOMAIN=${LANIA_HOSTNAME}

# SelfService URLs
SELFSERVICE_DEFAULT_BROWSER_RETURN_URL=https://${LANIA_UI_HOSTNAME}/welcome
SELFSERVICE_FLOWS_ERROR_UI_URL=https://${LANIA_UI_HOSTNAME}/auth/error
SELFSERVICE_FLOWS_SETTINGS_UI_URL=https://${LANIA_UI_HOSTNAME}/settings
SELFSERVICE_FLOWS_RECOVERY_UI_URL=https://${LANIA_UI_HOSTNAME}/auth/recovery
SELFSERVICE_FLOWS_VERIFICATION_UI_URL=https://${LANIA_UI_HOSTNAME}/auth/verification
SELFSERVICE_FLOWS_VERIFICATION_AFTER_DEFAULT_BROWSER_RETURN_URL=https://${LANIA_UI_HOSTNAME}
SELFSERVICE_FLOWS_LOGOUT_AFTER_DEFAULT_BROWSER_RETURN_URL=https://${LANIA_UI_HOSTNAME}
SELFSERVICE_FLOWS_LOGIN_UI_URL=https://${LANIA_UI_HOSTNAME}/auth/login
SELFSERVICE_FLOWS_REGISTRATION_UI_URL=https://${LANIA_UI_HOSTNAME}/auth/registration

# Secrets
SECRETS_COOKIE=PLEASE-CHANGE-ME-I-AM-VERY-INSECURE
SECRETS_CIPHER=32-LONG-SECRET-NOT-SECURE-AT-ALL

# Google OIDC
SELFSERVICE_METHODS_OIDC_CONFIG_PROVIDERS_0_CLIENT_ID=
SELFSERVICE_METHODS_OIDC_CONFIG_PROVIDERS_0_CLIENT_SECRET=

# Discord OIDC
SELFSERVICE_METHODS_OIDC_CONFIG_PROVIDERS_1_CLIENT_ID=
SELFSERVICE_METHODS_OIDC_CONFIG_PROVIDERS_1_CLIENT_SECRET=

# Yandex OIDC
SELFSERVICE_METHODS_OIDC_CONFIG_PROVIDERS_2_CLIENT_ID=
SELFSERVICE_METHODS_OIDC_CONFIG_PROVIDERS_2_CLIENT_SECRET=

# Twitch OIDC (basic scope)
SELFSERVICE_METHODS_OIDC_CONFIG_PROVIDERS_3_CLIENT_ID=
SELFSERVICE_METHODS_OIDC_CONFIG_PROVIDERS_3_CLIENT_SECRET=

# Twitch OIDC (extended scopes)
SELFSERVICE_METHODS_OIDC_CONFIG_PROVIDERS_4_CLIENT_ID=${SELFSERVICE_METHODS_OIDC_CONFIG_PROVIDERS_3_CLIENT_ID}
SELFSERVICE_METHODS_OIDC_CONFIG_PROVIDERS_4_CLIENT_SECRET=${SELFSERVICE_METHODS_OIDC_CONFIG_PROVIDERS_3_CLIENT_SECRET}
