PORT=9090
DEBUG=false

# Shared secret the API sends as "authorization: Bearer <token>". Empty disables auth.
SHELL_TOKEN=

# Shared MariaDB instance used by the Minecraft plugins
# Minecraft server RCON. Whitelist changes are RCON commands and fail without it.
# It also makes the server reload permissions after a change; when RCON_ADDRESS is empty
# that is skipped and permission changes apply on the next server sync or restart.
RCON_ADDRESS=
RCON_PASSWORD=
# Use "lp networksync" when LuckPerms messaging is set up across several servers.
LUCKPERMS_SYNC_COMMAND=lp sync
# Whitelist commands. {username} and {uuid} are replaced with the player values.
# Change them when a whitelist plugin is used instead of the vanilla whitelist.
WHITELIST_ADD_COMMAND=whitelist add {username}
WHITELIST_REMOVE_COMMAND=whitelist remove {username}

DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=

DATABASE_PLAN_NAME=plan
DATABASE_FLECTONE_NAME=flectone
DATABASE_LUCKPERMS_NAME=luckperms

LUCKPERMS_USER_PERMISSIONS_TABLE_NAME=luckperms_user_permissions
