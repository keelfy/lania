PORT=9090
DEBUG=false

# Shared secret the API sends as "authorization: Bearer <token>". Empty disables auth.
SHELL_TOKEN=

# Shared MariaDB instance used by the Minecraft plugins
# Minecraft server RCON. Used to make the server reload permissions after a change.
# Leave RCON_ADDRESS empty to skip; changes then apply on the next server sync or restart.
RCON_ADDRESS=
RCON_PASSWORD=
# Use "lp networksync" when LuckPerms messaging is set up across several servers.
LUCKPERMS_SYNC_COMMAND=lp sync

DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=

DATABASE_PLAN_NAME=plan
DATABASE_FLECTONE_NAME=flectone
DATABASE_LUCKPERMS_NAME=luckperms
DATABASE_WHITELIST_NAME=whitelist

LUCKPERMS_USER_PERMISSIONS_TABLE_NAME=luckperms_user_permissions
WHITELIST_TABLE_NAME=whitelist
