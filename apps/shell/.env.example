PORT=9090
DEBUG=false

# Shared secret the API sends as "authorization: Bearer <token>". Empty disables auth.
SHELL_TOKEN=

# Minecraft server RCON. Whitelist and prefix changes are RCON commands and fail without it.
# It also makes the server reload permissions after a role change; when RCON_ADDRESS is empty
# that is skipped and role changes apply on the next server sync or restart.
RCON_ADDRESS=
RCON_PASSWORD=
# Use "lp networksync" when LuckPerms messaging is set up across several servers.
LUCKPERMS_SYNC_COMMAND=lp sync
# Whitelist commands. {username} and {uuid} are replaced with the player values.
# Change them when a whitelist plugin is used instead of the vanilla whitelist.
WHITELIST_ADD_COMMAND=whitelist add {username}
WHITELIST_REMOVE_COMMAND=whitelist remove {username}
# Kicks the player after the in-game password is changed on the site. {username} is replaced.
KICK_COMMAND=kick {username} Пароль сменён на сайте, войдите с новым паролем

DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=

DATABASE_NAME=lania

# Plugin table names. LuckPerms, Plan and Flectone share the database above, so
# their tables carry a prefix. Change these when a plugin uses another prefix.
LUCKPERMS_USER_PERMISSIONS_TABLE_NAME=luckperms_user_permissions
LUCKPERMS_PLAYERS_TABLE_NAME=luckperms_players
PLAN_USERS_TABLE_NAME=plan_users
PLAN_SESSIONS_TABLE_NAME=plan_sessions
PLAN_SERVERS_TABLE_NAME=plan_servers
FLECTONE_PLAYER_TABLE_NAME=player

# NavAuth (login plugin on the proxy) keeps its tables in its own database on the same MySQL server.
# DATABASE_USER needs SELECT, INSERT and UPDATE on it.
NAVAUTH_DATABASE_NAME=navauth
NAVAUTH_USERS_TABLE_NAME=navauth_users
NAVAUTH_CREDENTIALS_TABLE_NAME=navauth_credentials
